# Copy to .env and fill in real values.  Do NOT commit .env.
PORT=3000

# Path to the Firebase Admin service-account JSON (download from
# Firebase Console > Project settings > Service accounts).
# This file is the real secret — keep it out of git.
GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccount.json

# Realtime Database URL (optional; only if you use RTDB)
FIREBASE_DATABASE_URL=https://huduma-4bc13-default-rtdb.firebaseio.com

# Firebase Web (client) SDK config — used for the email/password auth flows.
# These are public identifiers, not secrets, but keep them in env for portability.
FIREBASE_API_KEY=AIzaSyD-cPaG74E7yXIS9__ZB0UtqJoHcLxw8Yc
FIREBASE_AUTH_DOMAIN=huduma-4bc13.firebaseapp.com
FIREBASE_PROJECT_ID=huduma-4bc13
FIREBASE_STORAGE_BUCKET=huduma-4bc13.appspot.com
FIREBASE_MESSAGING_SENDER_ID=93399060513
FIREBASE_APP_ID=1:93399060513:web:ce4298700dff08d5001360
